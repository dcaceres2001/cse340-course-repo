<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Service Categories</h2>
        <p>Browse service projects by category to find opportunities that match your interests.</p>

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>
        <a href="/new-category">Add a new category</a>
    </main>

    <%- include('partials/footer') %>