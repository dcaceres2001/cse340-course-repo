<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Service Categories</h2>
        <p>Browse service projects by category to find opportunities that match your interests.</p>

        <ul>
            <% categories.forEach(category=> { %>
                <li><strong>
                        <p>Category: <%= category.name %>
                        </p>

                    </strong>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>