<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p class="page-intro">
            Browse service projects by category to find opportunities that match your interests.
        </p>

        <ul class="category-grid">
            <% categories.forEach(category=> { %>
                <li>
                    <a class="category-tile" href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>

        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a class="button-link" href="/new-category">Add New Category</a>
            <% } %>
        </p>
    </main>

    <%- include('partials/footer') %>