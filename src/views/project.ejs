<%- include('partials/header') %>
    <main>
        <a class="back-link" href="/projects">&larr; Back to projects</a>

        <article class="project-detail">
            <h1>
                <%= project.title %>
            </h1>

            <p class="project-meta">
                <span>
                    <strong>Date:</strong>
                    <%= new Date(project.date).toLocaleDateString('en-US', { weekday: 'long' , year: 'numeric' ,
                        month: 'long' , day: 'numeric' }) %>
                </span>
                <span><strong>Location:</strong>
                    <%= project.location %>
                </span>
            </p>

            <p class="project-detail-description">
                <%= project.description %>
            </p>
            <% if (categories.length> 0) { %>
                <ul class="tags">
                    <% categories.forEach(category=> { %>
                        <li>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
                <% } %>


                    <p class="project-org">
                        Organized by
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>
        </article>
    </main>

    <%- include('partials/footer') %>