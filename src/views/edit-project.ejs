<%- include('partials/header') %>

<main>
    <h1>
        <%= title %>
    </h1>


    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Name</label>
            <input type="text" id="title" name="title" value="<%= projectDetails.title %>" required maxlength="150" />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" required
                maxlength="500"><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= projectDetails.location %>" required maxlength="200" />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="<%= new Date(projectDetails.date).toLocaleDateString('en-CA') %>"
                required />
        </div>
        
        <div class="form-group">
            <label for="organizationId">Sponsoring Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="" disabled selected>-- Select an Organization --</option>
                <% organizations.forEach(org=> { %>
                    <option value="<%= org.organization_id %>">
                        <%= org.name %>
                    </option>
                    <% }); %>
            </select>
        </div>

        <button type="submit">Update Project</button>
    </form>

</main>

   <%- include('partials/footer') %>