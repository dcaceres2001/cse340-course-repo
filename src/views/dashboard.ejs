<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <section class="profile-card">
            <h2>Your account</h2>
            <dl class="profile-details">
                <dt>Name</dt>
                <dd>
                    <%= name %>
                </dd>

                <dt>Email</dt>
                <dd>
                    <%= email %>
                </dd>
            </dl>
        </section>

        <% if (role==='admin' ) { %>
            <section class="admin-actions">
                <h2>Admin tools</h2>
                <a class="button-link" href="/users">View all users</a>
            </section>
            <% } %>
    </main>

    <%- include('partials/footer') %>