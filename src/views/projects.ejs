<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        
        <ul>

            <% projects.forEach(project=> { %>
                <li><strong>
                        <p>Organization: <%= project.organization_name %>
                        </p>
                        <%= project.title %>
                    </strong>: <%= project.description %>
                        <p>Location: <%= project.location %>
                        </p>
                        <p><strong>Date:</strong>
                        <%= project.date.toLocaleDateString('en-US', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                            day: 'numeric' }) %>
                        </p>

                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>